{
  "name": "ai_research_analyst",
  "agents": [
    "topic_senior_data_researcher",
    "topic_reporting_analyst",
    "topic_report_writer"
  ],
  "tasks": [
    {
      "name": "conduct_thorough_research_on_task",
      "description": "Conduct thorough research on {topic}. Find the latest developments, key facts, major players, and credible sources. Focus on information that is accurate, recent, and relevant to the current year.",
      "expected_output": "A list of 10 bullet points with the most relevant findings about {topic}, each with a short explanation and its source.",
      "agent": "topic_senior_data_researcher"
    },
    {
      "name": "review_the_research_findings_task",
      "description": "Review the research findings on {topic}. Identify key trends, risks, opportunities, and any gaps or weak evidence. Organize the insights logically and explain what they mean.",
      "expected_output": "A structured analysis of {topic} with sections for key trends, risks, opportunities, and a short summary of the most important takeaways.",
      "agent": "topic_reporting_analyst"
    },
    {
      "name": "using_the_analysis_write_task",
      "description": "Using the analysis, write a complete, professional report on {topic}. Include an introduction, main findings, insights, risks and opportunities, and a conclusion. Use clear headings and a professional tone.",
      "expected_output": "The complete report on {topic} written directly as markdown text with clear headings. Respond with the report text only. Do not call any tools, do not run shell commands, and do not create files. No code fences around the report.",
      "agent": "topic_report_writer",
      "output_file": "report.md"
    }
  ],
  "process": "sequential",
  "verbose": true,
  "memory": false,
  "inputs": {}
}